{
  "name": "aws-mock-exam",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run banks:build && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node tests/run-browser.mjs",
    "banks:build": "node scripts/build-banks.mjs",
    "api": "npm --prefix backend start",
    "format": "prettier --write src/App.tsx src/App.css src/components src/lib src/screens src/types.ts scripts tests backend/src/app.js backend/src/access.js backend/src/database.js backend/src/questionApi.js backend/src/services/questionSchema.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.10.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
